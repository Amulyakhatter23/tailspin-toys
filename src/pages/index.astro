---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <form class="mb-8 grid gap-4 rounded-xl border border-slate-700 bg-slate-800/60 p-5 md:grid-cols-2" data-testid="game-filters">
        <fieldset>
          <legend class="mb-3 text-sm font-semibold text-slate-200">Filter by category</legend>
          <div class="flex flex-wrap gap-3">
            {categories.map((category) => (
              <label class="inline-flex cursor-pointer items-center gap-2 text-sm text-slate-300">
                <input
                  type="checkbox"
                  name="category"
                  value={category.id}
                  data-testid={`category-filter-${category.id}`}
                  class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-800"
                />
                <span>{category.name}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <div>
          <label for="publisher-filter" class="mb-3 block text-sm font-semibold text-slate-200">Filter by publisher</label>
          <select
            id="publisher-filter"
            name="publisher"
            data-testid="publisher-filter"
            class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="">All publishers</option>
            {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
          </select>
        </div>
      </form>

      <p class="mb-4 text-sm text-slate-300" data-testid="filter-result-count" aria-live="polite">
        Showing {games.length} {games.length === 1 ? 'game' : 'games'}
      </p>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
          {games.map((game) => (
            <div
              data-game-card-wrapper
              data-category-id={game.category?.id ?? ''}
              data-publisher-id={game.publisher?.id ?? ''}
            >
              <GameCard game={game} />
            </div>
          ))}
        </div>
      )}
      <div hidden data-testid="filter-empty-state">
        <EmptyState text="No games match the selected filters." />
      </div>
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-game-card-wrapper]'));
  const resultCount = document.querySelector<HTMLElement>('[data-testid="filter-result-count"]');
  const noMatches = document.querySelector<HTMLElement>('[data-testid="filter-empty-state"]');

  function applyFilters(): void {
    const categoryIds = Array.from(filterForm?.querySelectorAll<HTMLInputElement>('input[name="category"]:checked') ?? [])
      .map((input) => input.value);
    const publisherId = filterForm?.querySelector<HTMLSelectElement>('select[name="publisher"]')?.value ?? '';
    const visibleCards = cards.filter((card) => {
      const categoryMatches = categoryIds.length === 0 || categoryIds.includes(card.dataset.categoryId ?? '');
      const publisherMatches = publisherId === '' || card.dataset.publisherId === publisherId;
      const visible = categoryMatches && publisherMatches;
      card.hidden = !visible;
      return visible;
    });

    if (resultCount) {
      resultCount.textContent = `Showing ${visibleCards.length} ${visibleCards.length === 1 ? 'game' : 'games'}`;
    }
    if (noMatches) {
      noMatches.hidden = visibleCards.length > 0;
    }
  }

  filterForm?.addEventListener('change', applyFilters);
  if (noMatches) {
    noMatches.hidden = true;
  }
</script>
